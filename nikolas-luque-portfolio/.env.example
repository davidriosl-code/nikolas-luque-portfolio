# Optional. The portfolio and local J.A.R.V.I.S. commands work without API keys.
# Copy to .env.local and set your own values. Never commit .env.local.
JARVIS_ENABLE_LOCAL_AI=false
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternative provider; set AI_PROVIDER=openai to select this adapter.
OPENAI_API_KEY=
